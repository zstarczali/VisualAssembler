{
  "name": "c64-visual-assembler",
  "version": "2.1.3",
  "description": "Commodore 64 visual assembler desktop app.",
  "author": "Zsolt Tarczali",
  "scripts": {
    "dev": "concurrently -k -n SERVE,TAURI \"npx serve -l 1430 ./www\" \"tauri dev\"",
    "test": "node --test tests/*.test.js",
    "build": "tauri build",
    "build:win:x64": "tauri build --target x86_64-pc-windows-msvc",
    "build:win:arm64": "tauri build --target aarch64-pc-windows-msvc"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "concurrently": "^9",
    "serve": "^14"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
