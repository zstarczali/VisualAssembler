{
  "name": "c64-visual-assembler",
  "version": "1.0.9",
  "description": "Commodore 64 visual assembler desktop app built with Electron.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "build": {
    "appId": "hu.krissz.c64visualassembler",
    "productName": "C64 Visual Assembler",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "main.js",
      "preload.js",
      "package.json",
      "build/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/commodore64.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/commodore64.icns"
    },
    "dmg": {
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "C64 Visual Assembler"
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.8.1"
  }
}