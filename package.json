{
  "name": "c64-visual-assembler",
  "version": "1.1.3",
  "description": "Commodore 64 visual assembler desktop app built with Electron.",
  "author": "zstarczali",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --arm64",
    "dist:win:x64": "electron-builder --win nsis --x64",
    "dist:win:arm64": "electron-builder --win nsis --arm64",
    "dist:dir": "electron-builder --win dir"
  },
  "build": {
    "appId": "hu.krissz.c64visualassembler",
    "productName": "C64 Visual Assembler",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "main.js",
      "preload.js",
      "package.json",
      "build/**/*",
      "samples/**/*.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/commodore64.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/commodore64.icns",
      "identity": null
    },
    "dmg": {
      "sign": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "C64 Visual Assembler",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.8.1"
  }
}