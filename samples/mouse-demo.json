  "expertText": "* = $0801\n; MOUSE macro demo - sprite#0 follows a C64 1351 mouse on port 1. VICE: Settings > Input > Control Port 1 > Mouse (1351)\n; Init: select port 1 via CIA bits 7:6 (%01xxxxxx), then store raw POT samples in $FD/$FE\n.region Init\n    JMP main\n.align 64\n.byte $C0, $00, $00, $E0, $00, $00, $F0, $00, $00, $D8, $00, $00, $CC, $00, $00, $C6, $00, $00, $C3, $00, $00, $C1, $80, $00, $C0, $C0, $00, $C0, $60, $00, $C0, $30, $00, $C0, $18, $00, $C3, $FC, $00, $C6, $00, $00, $CC, $00, $00, $F8, $00, $00, $F0, $00, $00, $C0, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00, $00\n.endregion\n.region Main\nmain:\n    SEI\n    JSR $E544\n.text 15, 0, \"mouse demo\"\n.text 6, 2, \"move a 1351 mouse on port 1\"\n.text 3, 3, \"sprite tracks sid potx/poty delta\"\n.sprite_init 0, 1, $21\n.sprite_pos 0, 152, 100\n    LDA $DC00\n    AND #$3F\n    ORA #$40\n    STA $DC00\n    LDA $D419\n    STA $FD\n    LDA $D41A\n    STA $FE\ngameloop:\n.wait_raster $F8\n.mouse 1, 0, FD, FE\n.mouse 1, 0, FD, FE\n    JMP gameloop\n.endregion",
