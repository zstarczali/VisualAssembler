  },
  "expertText": "* = $0801\n.const scrolltext = $0900\n.const scrolltext_len = $4F\n.region init\n    SEI\n    LDA #$00\n    STA $D020\n    STA $D021\n    JSR $E544\n    LDA #$C8\n    STA $D016\n    LDA #$07\n    STA scroll_count\n    LDX #$00\nfill:\n    LDA scrolltext,X\n    JSR p2s\n    STA $05E0,X\n    INX\n    CPX #$28\n    BNE fill\n.endregion\n.region scroll_loop\nmain:\n-\n    LDA $D012\n    CMP #$FC\n    BNE -\n    LDA scroll_count\n    CMP #$FF\n    BEQ do_shift_now\n    ORA #$C8\n    STA $D016\n    DEC scroll_count\n    JMP done_frame\ndo_shift_now:\n    LDA #$CF\n    STA $D016\n    LDA #$07\n    STA scroll_count\n    LDX #$00\nshift:\n    LDA $05E1,X\n    STA $05E0,X\n    INX\n    CPX #$27\n    BNE shift\n    LDX char_idx\n    LDA scrolltext,X\n    JSR p2s\n    STA $0607\n    INX\n    CPX #scrolltext_len\n    BNE no_wrap\n    LDX #$00\nno_wrap:\n    STX char_idx\ndone_frame:\n-\n    LDA $D012\n    CMP #$FC\n    BEQ -\n    JMP main\n.endregion\n; PETSCII uppercase ($41-$5A) -> screen code ($01-$1A), others unchanged\np2s:\n    CMP #$41\n    BCC p2s_done\n    CMP #$5B\n    BCS p2s_done\n    SEC\n    SBC #$40\np2s_done:\n    RTS\n.region Data\nchar_idx:\n.byte $28\nscroll_count:\n.byte $00\n.petscii $0900, \"  smooth scrolling text demo on the commodore 64!  ---   visual assembler ---  \"\n.endregion ",
