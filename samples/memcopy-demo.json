  "expertText": "\n* = $0801\n\n.region Init\n.const _color = 0\n.const _screen = $0400\n.const _data = $0900\n\n.set_border _color\n.set_bg _color\n.endregion\n\n.region Data\n.rawtext _data, \">>> MEMCPY/MEMSET DEMO <<<<\"\n.endregion\n\n.region Copy\n.memset addr=_screen, value=32, size=1000\n.memcpy src=_data, dst=_screen, size=$001B\n.endregion\n\n.end\n",
