  "expertText": "* = $c000\n\nRASTER = $d012\nBORDER = $d020\nBACKGROUND = $d021\n\ninit:\n    sei\n    lda #0\n    sta BACKGROUND\nmainloop:\n    jsr wait_48\n    lda #2\n    sta BORDER\n    jsr wait_96\n    lda #5\n    sta BORDER\n    jsr wait_144\n    lda #7\n    sta BORDER\n    jsr wait_192\n    lda #0\n    sta BORDER\n    jmp mainloop\nwait_48:\n    lda RASTER\n    cmp #48\n    bne wait_48\n    rts\nwait_96:\n    lda RASTER\n    cmp #96\n    bne wait_96\n    rts\nwait_144:\n    lda RASTER\n    cmp #144\n    bne wait_144\n    rts\nwait_192:\n    lda RASTER\n    cmp #192\n    bne wait_192\n    rts\n",
