{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for C64 Visual Assembler",
  "windows": ["main", "about"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open-url",
    "shell:allow-spawn",
    "shell:allow-execute",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state"
  ]
}
